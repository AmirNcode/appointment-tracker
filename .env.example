# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# ── Supabase (TASKS T0.3) ──────────────────────────────────────────────────
# From your project's API settings (https://supabase.com/dashboard):
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY = publishable key (sb_publishable_...), safe in the browser
#   SUPABASE_SECRET_KEY                  = secret key (sb_secret_...), SERVER ONLY — bypasses RLS
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# ── App ────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Added in later phases (left here as a roadmap) ───────────────────────────
# GOOGLE_PLACES_API_KEY=        # Phase 3 — Google Places proxy (T3.1)
# RESEND_API_KEY=               # Phase 6 — email (T6.1)
# EMAIL_FROM=                   # Phase 6 — verified sender
# CRON_SECRET=                  # Phase 6 — authenticates the reminder cron (T6.4)
